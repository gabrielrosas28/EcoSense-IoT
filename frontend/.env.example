# URL do backend REST (padrao: /api, via proxy do Vite)
VITE_API_URL=/api

# URL do WebSocket de status (padrao: ws://<host>/ws)
# VITE_WS_URL=ws://localhost:3000/ws

# Backend usado pelo proxy do Vite em desenvolvimento
VITE_BACKEND_ORIGIN=http://localhost:3000

# Login de demonstracao: se o backend estiver fora do ar, entra sem credenciais.
# Deixe false para exigir o backend (usuario do seed: admin@ecosense.local / ecosense123)
VITE_AUTH_MOCK=false
