# ---- Broker MQTT ----
MQTT_URL=mqtt://localhost:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=

# ---- Simulação ----
# Passo da física (ms, tempo real)
SIM_TICK_MS=1000
# Multiplicador do tempo: 60 = 1 minuto simulado por segundo (bom para demo)
SIM_SPEED=1
# Status periódico de todos os dispositivos (ms). Mudanças saem na hora.
SIM_PUBLISH_MS=5000
# Subconjunto de dispositivos (vazio = todos): luz,projetor,irrigacao,umidificador
# SIM_DEVICES=irrigacao,umidificador
# Semente do gerador aleatório (leituras reproduzíveis)
# SIM_SEED=42
# 1 = loga também o status periódico
SIM_VERBOSE=0
