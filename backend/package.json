{
  "name": "ecosense-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API do EcoSense IoT (Node.js + Express + PostgreSQL), ponte entre o painel React e os dispositivos da sala.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node scripts/db.js migrate",
    "db:seed": "node scripts/db.js seed",
    "db:reset": "node scripts/db.js reset",
    "db:local": "node scripts/local-db.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mqtt": "^5.16.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "aedes": "^1.2.0",
    "oxlint": "^1.86.0",
    "supertest": "^7.3.0",
    "vitest": "^5.0.3"
  }
}
