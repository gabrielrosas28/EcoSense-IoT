# Copie para .env (cp .env.example .env) e ajuste se precisar.

# ---- Servidor ----
NODE_ENV=development
PORT=3000
# Origens liberadas no CORS, separadas por vírgula. O Vite roda em 5173.
CORS_ORIGIN=http://localhost:5173

# ---- Banco (PostgreSQL) ----
# Já aponta para o banco do docker-compose.yml (e para o `npm run db:local`).
DATABASE_URL=postgresql://ecosense:ecosense@localhost:5432/ecosense
DB_POOL_MAX=10

# ---- Autenticação ----
# Segredo dos tokens de sessão. Para gerar um:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-este-valor-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=8h

# ---- Outros ----
# Fuso usado no horário exibido no histórico de eventos
APP_TIMEZONE=America/Sao_Paulo
