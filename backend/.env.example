# ---- Banco (Postgres) ----
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
DATABASE_URL="postgresql://ecosense:ecosense@localhost:5432/ecosense?schema=public"

# ---- Servidor ----
PORT=3000
NODE_ENV=development

# Origens permitidas no CORS (separadas por virgula). O Vite roda em 5173.
CORS_ORIGIN=http://localhost:5173

# ---- Autenticacao ----
# Troque por um valor aleatorio longo. Em producao, NUNCA use o valor de exemplo.
JWT_SECRET=troque-este-valor-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=7d
